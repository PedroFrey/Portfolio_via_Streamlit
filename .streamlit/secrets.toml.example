# Copie este arquivo para .streamlit/secrets.toml (gitignored) e preencha os valores.
# Em produção (Render), configure as mesmas chaves como env vars — pydantic-settings
# le de ambos os lugares.

PHONE_NUMBER = ""
CALL_ME_BOT_API_KEY = ""

# Sentry (observabilidade / error tracking). Deixe em branco para desabilitar.
SENTRY_DSN = ""

# "development" | "production" — controla verbosidade de logs e Sentry sample rate
ENVIRONMENT = "development"
LOG_LEVEL = "INFO"

# PostHog (analytics de produto). Deixe em branco para desabilitar.
POSTHOG_API_KEY = ""
POSTHOG_HOST = "https://us.i.posthog.com"
